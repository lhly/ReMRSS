<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".RecordingControlsDiagnosticActivity"
            android:enabled="${uxPhoneValidation}"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Transparent" />
        <receiver
            android:name=".DebugCastAdmissionDiagnosticReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="top.zainzh.rearscreen.debug.action.READ_CAST_ADMISSION" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".ComposeTestHostActivity"
            android:exported="false"
            android:theme="@style/MiuixHostTheme" />
        <activity
            android:name=".CastApprovalTestHostActivity"
            android:exported="false"
            android:theme="@style/MiuixCastOverlayTheme" />
        <activity
            android:name=".FixtureNotificationActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.fixtureNotification"
            android:theme="@style/Theme.Transparent"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|smallestScreenSize|density" />
        <activity
            android:name=".FixtureRearScreenshotActivity"
            android:exported="false"
            android:theme="@style/MiuixHostTheme" />
        <activity
            android:name=".FixtureWallpaperSettingsActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"
            android:theme="@style/MiuixHostTheme" />
        <activity
            android:name=".FixtureWallpaperEditorActivity"
            android:exported="false"
            android:theme="@style/MiuixHostTheme" />
        <activity
            android:name=".FixtureChargingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|smallestScreenSize|density"
            android:theme="@style/Theme.Transparent" />
        <activity
            android:name=".FixtureCastNotificationActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/MiuixHostTheme" />
        <activity
            android:name=".NotificationConsentPreviewActivity"
            android:exported="false"
            android:theme="@style/MiuixHostTheme" />
        <activity
            android:name=".platform.mods.ModDebugReloadActivity"
            android:exported="true"
            android:label="Mod 开发重载"
            android:theme="@style/MiuixHostTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
